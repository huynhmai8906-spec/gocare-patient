# Sao chép file này thành ".env" rồi điền giá trị.

PORT=8787

# Supabase dùng chung của Web Quản Lý (quanlyweb-bjsh) và Web Khách Hàng.
# Lấy tại Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://niptzzxfgduhcrbofthg.supabase.co
# KHÓA BÍ MẬT (service_role / sb_secret_...) — chỉ để trên máy chạy bridge, KHÔNG đưa vào app hay GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Mã kết nối dùng chung cho App Bệnh Nhân và Camera chống té ngã (tự đặt, càng dài càng tốt).
API_TOKEN=

# Địa chỉ công khai của bridge (để link ảnh té ngã mở được từ web quản lý), ví dụ https://gocare-bridge.example.com
PUBLIC_BASE_URL=http://localhost:8787

# (Tuỳ chọn) user_id Supabase của bệnh nhân — để cảnh báo đỏ trong triage_reports gắn đúng hồ sơ.
PATIENT_USER_ID=

# Gộp các cảnh báo cùng loại trong N giây (tránh tạo hàng loạt đơn trùng).
DEDUPE_SECONDS=60

# Tạo thêm 1 dòng triage_reports (urgent=true) để web quản lý bật thông báo đỏ.
ALSO_TRIAGE_REPORT=true

# (Tuỳ chọn) Cột bắt buộc khác của bảng nursing_bookings nếu database yêu cầu, dạng JSON.
# Ví dụ: NURSING_EXTRA_FIELDS={"care_mode":"home"}
NURSING_EXTRA_FIELDS={}
